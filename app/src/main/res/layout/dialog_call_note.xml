<?xml version="1.0" encoding="utf-8"?>
<!-- 通话备注表单：悬浮窗与 CallNoteActivity 共用；只用原生控件，悬浮窗里没有 XUI 主题也能正常渲染 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_call_note"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="UnusedAttribute">

    <TextView
        android:id="@+id/tv_call_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/call_note_title"
        android:textColor="#DE000000"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_call_note_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#8A000000"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_call_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="top|start"
        android:hint="@string/call_note_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="6"
        android:minLines="3"
        android:textColor="#DE000000"
        android:textColorHint="#61000000"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_call_note_skip"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_note_skip"
            android:textColor="#8A000000" />

        <Button
            android:id="@+id/btn_call_note_later"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_note_later"
            android:textColor="#8A000000" />

        <Button
            android:id="@+id/btn_call_note_send"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_note_send"
            android:textColor="@color/colorPrimary"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
